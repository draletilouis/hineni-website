# Copy to .env for local use. On Railway, set these as service variables instead (most aren't needed there).
# PORT=8787                     Railway sets this itself
# Where uploads, accounts, media and the live site file are kept. Must survive restarts and redeploys.
# On Railway it's the volume (RAILWAY_VOLUME_MOUNT_PATH), found automatically. Locally: ./storage.
# DATA_DIR=storage
# Behind an HTTPS proxy other than Railway's (nginx, Render…): 1. Automatic on Railway.
# TRUST_PROXY=1
# First run only: creates this admin if there are no admins yet. Remove afterwards; add more with `npm run admin`.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
